# Copy to .env and fill in values
NODE_ENV=development

# Canonical site URL. Everything SEO-related derives from this: canonicals,
# sitemap entries, OG URLs and the schema.org entity @ids.
#
# IMPORTANT: while this points at a *.vercel.app host the whole deployment
# serves `noindex` on purpose. The entity @ids are built from this value and
# must never change once Google has indexed them, so the temporary deployment
# host is kept out of the index. Setting this to the real domain
# (https://highdesign.arq.br) turns indexing on by itself — there is no second
# flag to flip. See lib/seo.ts.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp — number with country code, no symbols (e.g. 5511999990000)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Formspree — form ID from formspree.io/forms (e.g. xpwzqrkv)
NEXT_PUBLIC_FORMSPREE_ID=

# Instagram — full profile URL (e.g. https://instagram.com/highdesign.arq). Footer link hidden until set.
NEXT_PUBLIC_INSTAGRAM_URL=

# LinkedIn — full company URL (e.g. https://linkedin.com/company/highdesign). Footer link hidden until set.
NEXT_PUBLIC_LINKEDIN_URL=

# Google Search Console — the token from the "HTML tag" verification method
# (just the content value, not the whole <meta> tag). Optional: the DNS
# verification method needs no value here.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
